{
  "expo": {
    "name": "AMAC_FR5",
    "slug": "AMAC_FR5",
    "version": "1.6.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "現地調査と軌跡ログ記録のために位置情報を使用します。",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "スリープ時や別アプリ使用中にも軌跡を記録し続けるために位置情報を使用します。",
        "NSLocationAlwaysUsageDescription": "バックグラウンドで常に軌跡を記録するために位置情報を使用します。",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.anonymous.FR5Android"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationAlwaysPermission": "スリープ時や別アプリ使用中にも軌跡を記録し続けるために位置情報を使用します。"
        }
      ]
    ]
  }
}
